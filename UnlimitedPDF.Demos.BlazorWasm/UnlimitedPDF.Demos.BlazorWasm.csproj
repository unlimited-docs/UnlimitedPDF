<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Deep links such as /playground/documents/invoice are answered with index.html, so a refresh or a shared
         link opens the page instead of a 404. -->
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>

    <!-- Fast first load: no culture data or time-zone database is downloaded. Trimming and Brotli/gzip
         compression stay on through the template's publish defaults, and AOT stays off (smaller download). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnlimitedPDF\UnlimitedPDF.csproj" />
  </ItemGroup>

  <!-- Each sample builder's source is embedded so the page shows exactly the code that runs. -->
  <ItemGroup>
    <EmbeddedResource Include="Samples\*Sample.cs" LogicalName="Samples.%(Filename)%(Extension)" />
    <!-- The home page's code samples, shown from the same compiled file (PR-012). -->
    <EmbeddedResource Include="Samples\HomeSnippets.cs" LogicalName="Samples.HomeSnippets.cs" />
    <!-- The FAQ page's code samples, shown the same way. -->
    <EmbeddedResource Include="Samples\FaqSnippets.cs" LogicalName="Samples.FaqSnippets.cs" />
  </ItemGroup>

</Project>
