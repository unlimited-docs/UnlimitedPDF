<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Deep links such as /playground/documents/invoice are answered with index.html, so a refresh or a shared
         link opens the page instead of a 404. -->
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>

    <!-- Fast first load: no culture data or time-zone database is downloaded. Trimming and Brotli/gzip
         compression stay on through the template's publish defaults, and AOT stays off (smaller download). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnlimitedPDF\UnlimitedPDF.csproj" />
  </ItemGroup>

  <!-- Each sample builder's source is embedded so the page shows exactly the code that runs. -->
  <ItemGroup>
    <EmbeddedResource Include="Samples\*Sample.cs" LogicalName="Samples.%(Filename)%(Extension)" />
    <!-- The home page's code samples, shown from the same compiled file (PR-012). -->
    <EmbeddedResource Include="Samples\HomeSnippets.cs" LogicalName="Samples.HomeSnippets.cs" />
    <!-- The FAQ page's code samples, shown the same way. -->
    <EmbeddedResource Include="Samples\FaqSnippets.cs" LogicalName="Samples.FaqSnippets.cs" />
  </ItemGroup>

  <!-- The site's Content-Security-Policy (staticwebapp.config.json) allows one inline script: the import map the build
       writes into index.html. Its hash changes with every build, so it is worked out after publish and written into the
       published config in place of IMPORTMAP-HASH (26111701 T-14). -->
  <UsingTask TaskName="WriteImportMapHash" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Folder ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string html = File.ReadAllText(Path.Combine(Folder, "index.html"));
        var map = Regex.Match(html, "<script type=\"importmap\">(.*?)</script>", RegexOptions.Singleline);
        string configPath = Path.Combine(Folder, "staticwebapp.config.json");
        string config = File.ReadAllText(configPath);
        if (!map.Success || !config.Contains("IMPORTMAP-HASH"))
        {
            Log.LogError("WriteImportMapHash: index.html has no import map, or the config has no IMPORTMAP-HASH to replace.");
            return false;
        }
        using (var sha = SHA256.Create())
        {
            // The browser hashes the script as parsed, with every line break as one line feed.
            string text = map.Groups[1].Value.Replace("\r\n", "\n").Replace('\r', '\n');
            string hash = Convert.ToBase64String(sha.ComputeHash(Encoding.UTF8.GetBytes(text)));
            File.WriteAllText(configPath, config.Replace("IMPORTMAP-HASH", hash));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WriteImportMapHashAfterPublish" AfterTargets="Publish">
    <WriteImportMapHash Folder="$(PublishDir)wwwroot" />
  </Target>
</Project>
