@inherits LayoutComponentBase

@* The first Tab stop on every page: skips the top bar (and the playground sidebar) to the page's own content. The
   click moves focus in code, because a bare "#main-content" link resolves against the base href and would open Home. *@
<a class="skip-link" href="#main-content" @onclick="SkipToContentAsync" @onclick:preventDefault>Skip to content</a>

<header class="topbar">
    <div class="topbar-inner">
        <div class="brand-group">
            <a class="brand" href="">
                @* Phones get the square icon instead of the wordmark; the browser downloads only the one it shows. *@
                <picture>
                    <source media="(max-width: 575.98px)" srcset="images/unlimitedpdf-icon.png" width="31" height="30" />
                    <img src="images/unlimitedpdf-logo.png" alt="UnlimitedPDF home" width="154" height="30" />
                </picture>
            </a>
            @* The library version this site is built with, beside the logo on every page (QF-26111209). Screen readers
               read "v1.0.0 release notes". *@
            @if (LibraryRelease.Version.Length > 0)
            {
                <a class="version-link" href="@LibraryRelease.NotesUrl" target="_blank" rel="noopener">
                    <span class="version-badge">v@(LibraryRelease.Version)</span><span class="visually-hidden"> release notes</span>
                </a>
            }
        </div>
        <nav class="topnav" aria-label="Main">
            <NavLink class="topnav-link topnav-home" href="" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink class="topnav-link" href="playground" Match="NavLinkMatch.Prefix">Playground</NavLink>
            <NavLink class="topnav-link" href="faq" Match="NavLinkMatch.All">FAQ</NavLink>
            <a class="topnav-link topnav-github" href="https://github.com/unlimited-docs/UnlimitedPDF" target="_blank" rel="noopener">GitHub</a>
            <a class="btn btn-sm btn-solid theme-primary topnav-cta" href="https://www.nuget.org/packages/UnlimitedPDF" target="_blank" rel="noopener">
                <span class="cta-long">Get it on </span>NuGet
            </a>
        </nav>
    </div>
</header>

<main id="main-content" class="app-main" tabindex="-1">
    @Body
</main>

@* On every page. The heart icon is hidden from screen readers, which read the word "love" instead. *@
<footer class="footer">
    <p>
        Designed and built with <Icon Name="heart" Size="14" Class="footer-heart" /><span class="visually-hidden">love</span>
        by the <a href="https://github.com/unlimited-docs" target="_blank" rel="noopener">UnlimitedDocs team</a> and our
        <a href="https://github.com/unlimited-docs/UnlimitedPDF/graphs/contributors" target="_blank" rel="noopener">contributors</a>.
    </p>
    <p>Powered by .NET 11 · Open source under the <span class="text-nowrap">Apache-2.0</span> license · Demo data is fictional.</p>
</footer>
