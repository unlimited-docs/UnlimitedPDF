@inherits LayoutComponentBase
@layout MainLayout
@implements IDisposable

@* Demo pages (D-023): a breadcrumb back to the scenario gallery and to the demo's capability, then the demo with its
   data, PDF, and code. Every demo is reached from the gallery or the site-wide search. *@
<div class="playground">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumbs">
            <li><a href="@ScenarioGallery.Route">Scenarios</a></li>
            @if (_category is { } category)
            {
                <li><a href="@ScenarioGallery.Address(category.Id, null)">@category.Title</a></li>
            }
        </ol>
    </nav>

    @* The skip link's destination here: the demo itself, past the breadcrumb. *@
    <div class="playground-content" data-skip-target tabindex="-1">
        @Body
    </div>
</div>
