@* Small line icons drawn for this app (project-authored; no icon font or library is downloaded). *@
<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "text":
            <path d="M5 6h14M12 6v13M9 19h6" />
            break;
        case "table":
            <rect x="3.5" y="4.5" width="17" height="15" rx="2" /><path d="M3.5 10h17M3.5 15h17M10 4.5v15" />
            break;
        case "image":
            <rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="10" r="1.8" /><path d="m4 18 5-5 4 4 3-3 4 4" />
            break;
        case "invoice":
            <path d="M6 3.5h12v17l-3-2-3 2-3-2-3 2z" /><path d="M9 8h6M9 12h6M9 16h3" />
            break;
        case "pulse":
            <rect x="3.5" y="4.5" width="17" height="15" rx="2" /><path d="M6 12h3l2-4 2 8 2-4h3" />
            break;
        case "receipt":
            <path d="M7 3.5h10v17l-2.5-1.5-2.5 1.5-2.5-1.5L7 20.5z" /><path d="M10 8h4M10 11.5h4M10 15h2" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3" /><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" /><path d="M16 5.5a3 3 0 0 1 0 5.5M17.5 14c2 .5 3 2.3 3 5" />
            break;
        case "award":
            <circle cx="12" cy="9" r="5.5" /><path d="m9 14-1.5 6.5L12 18l4.5 2.5L15 14" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case "copy":
            <rect x="8.5" y="8.5" width="11" height="11" rx="2" /><path d="M15.5 8.5V6a2 2 0 0 0-2-2h-7.5a2 2 0 0 0-2 2v7.5a2 2 0 0 0 2 2h2.5" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "download":
            <path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19.5h14" />
            break;
        case "link":
            <path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.2 1.2M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2" />
            break;
        case "external":
            <path d="M14 4.5h5.5V10M19.5 4.5 11 13M17 13.5v5a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 4 18.5v-10A1.5 1.5 0 0 1 5.5 7h5" />
            break;
        case "chevron":
            <path d="m7 10 5 5 5-5" />
            break;
        case "upload":
            <path d="M12 16V5M7.5 9.5 12 5l4.5 4.5M5 19.5h14" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "spark":
            <path d="M12 3.5v4M12 16.5v4M3.5 12h4M16.5 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18" />
            break;
        case "arrow":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6" /><path d="m15.5 15.5 4 4" />
            break;
        case "pen":
            <path d="M4 20l1-4.5L15.5 5a2.1 2.1 0 0 1 3 3L8 18.5z" /><path d="M13.5 7l3 3" />
            break;
        case "merge":
            <path d="M7 3.5v4c0 3 2.2 5.5 5 5.5s5-2.5 5-5.5v-4M12 13v7.5M9.5 18l2.5 2.5 2.5-2.5" />
            break;
        case "split":
            <path d="M12 3.5V9M12 9c-2.8 0-5 2.2-5 5v6.5M12 9c2.8 0 5 2.2 5 5v6.5M4.5 18 7 20.5 9.5 18M14.5 18l2.5 2.5 2.5-2.5" />
            break;
        case "code":
            <path d="m8.5 7.5-5 4.5 5 4.5M15.5 7.5l5 4.5-5 4.5M13.5 5l-3 14" />
            break;
        case "layout":
            <rect x="4.5" y="3.5" width="15" height="17" rx="2" /><path d="M4.5 8h15M4.5 16h15M8 12h8" />
            break;
        case "join":
            <rect x="3.5" y="3.5" width="7" height="9" rx="1.5" /><rect x="13.5" y="3.5" width="7" height="9" rx="1.5" /><path d="M7 12.5V14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1.5M12 16v4.5" />
            break;
        case "cover":
            <rect x="5.5" y="3.5" width="13" height="17" rx="2" /><path d="M5.5 9.5h13M9 6.5h6M9 13h6M9 16.5h4" />
            break;
        case "pick":
            <path d="M14 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5z" /><path d="M14 3.5v5h5M9 14l2 2 4-4" />
            break;
        case "bookmark":
            <path d="M7 3.5h10v17l-5-4-5 4z" />
            break;
        case "calendar":
            <rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4M8 14h3" />
            break;
        case "badge":
            <rect x="3.5" y="5.5" width="17" height="13" rx="2" /><circle cx="9" cy="11" r="2" /><path d="M6 16c.5-1.5 1.6-2.3 3-2.3s2.5.8 3 2.3M14.5 10h3M14.5 13.5h3" />
            break;
        case "heart":
            <path d="M12 19.5s-7.5-4.6-7.5-9.8A4.2 4.2 0 0 1 12 7a4.2 4.2 0 0 1 7.5 2.7c0 5.2-7.5 9.8-7.5 9.8z" />
            break;
        case "pages":
            <rect x="3" y="6" width="5" height="12" rx="1" /><rect x="9.5" y="6" width="5" height="12" rx="1" /><rect x="16" y="6" width="5" height="12" rx="1" />
            break;
        case "ranges":
            <path d="M8 4.5H5.5v15H8M16 4.5h2.5v15H16M10 12h4" />
            break;
        case "html":
            <path d="M14 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5z" /><path d="M14 3.5v5h5M10 12l-2 2 2 2M14 12l2 2-2 2" />
            break;
        case "warning":
            <path d="M12 4 21 19.5H3z" /><path d="M12 10v4.5M12 17.2v.1" />
            break;
    }
</svg>

@code {
    /// <summary>
    /// Gets or sets extra CSS classes for the icon.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Gets or sets the icon name, for example "table".
    /// </summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>
    /// Gets or sets the icon size in CSS pixels.
    /// </summary>
    [Parameter] public int Size { get; set; } = 20;
}
