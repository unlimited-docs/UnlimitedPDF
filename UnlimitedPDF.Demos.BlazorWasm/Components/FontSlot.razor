<div class="font-slot @(Needed ? "is-needed" : null)">
    <div class="font-slot-head">
        <strong>@Script font</strong>
        @if (Needed)
        {
            <span class="font-slot-needed">Needed</span>
        }
        <a class="font-slot-link" href="@FontSlots.FreeFontLink(Script)" target="_blank" rel="noopener noreferrer"
           title="Opens a free @Script font family on a public font site in a new tab">Get a free one <Icon Name="external" Size="14" /></a>
    </div>

    @if (Value is { } font)
    {
        <div class="font-slot-file">
            <Icon Name="check" Size="16" />
            @if (font.Bundled is { } bundled)
            {
                <span title="@font.FileName">@bundled.Name (included) · @Describe(font.Font)</span>
            }
            else
            {
                <span title="@font.FileName">@font.FileName · @Describe(font.Font)</span>
            }
            <button type="button" class="row-remove" title="Remove the @Script font" aria-label="Remove the @Script font" @onclick="RemoveAsync">
                <Icon Name="close" Size="16" />
            </button>
        </div>
        @if (font.Bundled is not null)
        {
            <p class="field-hint">A free font under the <a href="@BundledFonts.LicensePath" target="_blank" rel="noopener">@BundledFonts.LicenseName</a>, included only for this demo.</p>
        }
        @if (!_covers)
        {
            <p class="field-hint">This font has no @Script letters. It is still used for any other characters it has.</p>
        }
    }

    @if (_reading)
    {
        <div class="upload-reading" role="status">
            <span class="spinner-border spinner-sm spinner-sm-inline" aria-hidden="true"></span> Reading the font...
        </div>
    }

    @* The file input stays in the page while its file is read, so it is hidden rather than removed. *@
    <label class="dropzone" hidden="@_reading">
        <InputFile class="dropzone-input" OnChange="OnFileChosenAsync" accept=".ttf,.otf,font/ttf,font/otf" aria-label="@($"Upload a {Script} font")" />
        <strong>@(Value is null ? "Drop a .ttf or .otf font" : Value.Bundled is null ? "Drop another font to replace it" : "Use your own font: drop a .ttf or .otf")</strong>
        <span>or click to browse · up to @(PdfFont.DefaultMaxFileSize / (1024 * 1024)) MB</span>
    </label>

    @if (_error is not null)
    {
        <p class="field-error" role="alert">@_error</p>
    }
    @if (_restrictedBytes is not null)
    {
        <label class="check-field">
            <input type="checkbox" @onchange="AssertRightsAsync" /> I have the right to embed this font
        </label>
    }
</div>
