@* One choice among a demo's variants (a document type, a pack's domain), as a labelled list of links. Each variant
   has its own address, so it can be linked to, kept on reload, and reached with Back. Following a link replaces the
   page's form, so focus is put back on the chosen link instead of being lost (WCAG 2.4.3). *@
<nav class="demo-choice" aria-labelledby="@_labelId">
    <span class="demo-choice-label" id="@_labelId">@Legend</span>
    <ul class="demo-choice-options">
        @foreach (var option in Options)
        {
            <li>
                @if (option == Selected)
                {
                    <a class="demo-choice-option" href="@option.Address" aria-current="page" @ref="_current">@option.Label</a>
                }
                else
                {
                    <a class="demo-choice-option" href="@option.Address" @onclick="() => s_focusAddress = option.Address">@option.Label</a>
                }
            </li>
        }
    </ul>
</nav>

@code {
    // The address of the link just followed. The page is replaced, and this component with it, so the new page's
    // choice reads it to take focus; the old one, which renders once more after the click, does not match it.
    private static string? s_focusAddress;

    private readonly string _labelId = $"choice-{Guid.NewGuid():N}";
    private ElementReference _current;

    /// <summary>
    /// Gets or sets the label of the list.
    /// </summary>
    [Parameter, EditorRequired] public string Legend { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the variants, in the order shown.
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlyList<DemoVariant> Options { get; set; } = Array.Empty<DemoVariant>();

    /// <summary>
    /// Gets or sets the variant shown now.
    /// </summary>
    [Parameter, EditorRequired] public DemoVariant Selected { get; set; } = default!;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (s_focusAddress is null || s_focusAddress != Selected.Address) return;
        s_focusAddress = null;
        await _current.FocusAsync();
    }
}
