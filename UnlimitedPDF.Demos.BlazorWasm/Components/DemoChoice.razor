@* One choice among a demo's variants (a document type, a pack's domain), as a labelled list of links. Each variant
   has its own address, so it can be linked to, kept on reload, and reached with Back. Moving to another variant, by a
   link or by Back and Forward, replaces the page's form, so the host page asks for focus on the shown variant's link
   instead of letting it be lost (WCAG 2.4.3). *@
<nav class="demo-choice" aria-labelledby="@_labelId">
    <span class="demo-choice-label" id="@_labelId">@Legend</span>
    <ul class="demo-choice-options">
        @foreach (var option in Options)
        {
            <li>
                @if (option == Selected)
                {
                    @* Following the shown variant's own link would only add a second history entry for the same page. *@
                    <a class="demo-choice-option" href="@option.Address" aria-current="page" @ref="_current" @onclick:preventDefault>@option.Label</a>
                }
                else
                {
                    <a class="demo-choice-option" href="@option.Address">@option.Label</a>
                }
            </li>
        }
    </ul>
</nav>

@code {
    private readonly string _labelId = $"choice-{Guid.NewGuid():N}";
    private ElementReference _current;

    /// <summary>
    /// Gets or sets the label of the list.
    /// </summary>
    [Parameter, EditorRequired] public string Legend { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the variants, in the order shown.
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlyList<DemoVariant> Options { get; set; } = Array.Empty<DemoVariant>();

    /// <summary>
    /// Gets or sets the variant shown now.
    /// </summary>
    [Parameter, EditorRequired] public DemoVariant Selected { get; set; } = default!;

    /// <summary>
    /// Gets or sets whether the shown variant's link takes focus when the choice first shows: true when the page has
    /// just moved here from another of its variants (see <see cref="DemoVariants.Moved"/>).
    /// </summary>
    [Parameter] public bool TakeFocus { get; set; }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && TakeFocus) await _current.FocusAsync();
    }
}
