@* The page frame of the Split demos (D-023): the visitor's data with Split, the parts with the drawn preview of the
   chosen part and a download of each or of all as one zip, and the C# code, side by side on wide screens and stacked
   in that order on phones. *@
<PageTitle>@Demo.DocumentTitle</PageTitle>
<PageDescription Text="@Demo.Description" />
<CanonicalLink Path="@Demo.Route" />

<article class="demo">
    <header class="demo-header">
        <h1>@(Demo.Heading ?? Demo.Title)</h1>
        <p class="demo-lead">@Demo.Description</p>
        <ScenarioToolLink Demo="Demo" />
    </header>

    <div class="demo-grid">
        <section class="panel demo-inputs" id="@($"{_id}-options")" tabindex="-1" @ref="_optionsSection" aria-labelledby="@($"{_id}-data")">
            <h2 class="demo-column-title" id="@($"{_id}-data")">Your data</h2>
            <div class="demo-inputs-body" @oninput="OnInputsChanged" @onchange="OnInputsChanged" @onkeydown="OnInputsKeyDownAsync">
                @Inputs
            </div>
            <div class="demo-actions">
                <button type="button" class="btn btn-solid theme-primary btn-generate" aria-disabled="@(_busy ? "true" : null)" @onclick="() => SplitAsync(userStarted: true)">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-sm spinner-sm-inline" aria-hidden="true"></span>
                        <span>@Wording.Busy</span>
                    }
                    else
                    {
                        <span>@Wording.Action</span>
                    }
                </button>
                <button type="button" class="btn btn-text" aria-disabled="@(_busy ? "true" : null)" @onclick="ResetAsync">Reset to defaults</button>
                <span class="demo-shortcut"><kbd>Ctrl</kbd> + <kbd>Enter</kbd></span>
            </div>
        </section>

        <section class="panel demo-output" @ref="_outputSection" aria-labelledby="@($"{_id}-parts")">
            <div class="output-head">
                <h2 class="demo-column-title" id="@($"{_id}-parts")">@Wording.Heading</h2>
                <div class="output-actions">
                    @* Where the data sits above the parts, this brings it back in one tap. *@
                    <button type="button" class="btn btn-sm btn-text back-to-options" @onclick="BackToOptionsAsync" title="Scroll up to this demo's options">
                        <Icon Name="pen" Size="16" /> Back to options
                    </button>
                    <button type="button" class="btn btn-sm btn-outline" disabled="@(_parts.Count == 0 || _busy)" @onclick="DownloadZipAsync" title="@($"Download every {Wording.One} in one zip file")">
                        <Icon Name="download" Size="16" /> Download all (.zip)
                    </button>
                </div>
            </div>

            @if (_error is not null)
            {
                <div class="error-box" role="alert">
                    <p><strong>@Wording.Failed</strong> @_error</p>
                    <button type="button" class="btn btn-sm btn-outline" @onclick="() => SplitAsync(userStarted: true)">Try again</button>
                </div>
            }

                @if (_parts.Count > 0)
                {
                    <ol class="split-parts" aria-label="@Wording.Heading">
                        @for (int i = 0; i < _parts.Count; i++)
                        {
                            int index = i;
                            var part = _parts[index].Part;
                            <li class="split-part@(index == _selected ? " is-selected" : string.Empty)">
                                <span class="split-part-name">@part.FileName</span>
                                <span class="split-part-pages">@PagesText(part, Wording.CountsPages)</span>
                                <span class="split-part-size">@FormatSize(_parts[index].Bytes.Length)</span>
                                <span class="split-part-actions">
                                    <button type="button" class="btn btn-sm btn-text" disabled="@_busy" aria-pressed="@(index == _selected ? "true" : "false")"
                                            aria-label="Preview @part.FileName" @onclick="() => SelectAsync(index)">Preview</button>
                                    <button type="button" class="btn btn-sm btn-outline" disabled="@_busy"
                                            aria-label="Download @part.FileName" @onclick="() => DownloadPartAsync(index)">
                                        <Icon Name="download" Size="16" /> Download
                                    </button>
                                </span>
                            </li>
                        }
                    </ol>
                }
                <PdfPreview @ref="_preview" Busy="_busy" />

            <div class="status-bar">
                @if (_result is { } result)
                {
                    <span class="status-meta">
                        <span><strong>@result.Parts</strong> @(result.Parts == 1 ? Wording.One : Wording.Many)</span>
                        <span><strong>@FormatSize(result.Bytes)</strong> in all</span>
                        <span>@Wording.Done in <strong>@result.Milliseconds ms</strong></span>
                        @if (Wording.TimesEach && result.Parts > 0)
                        {
                            <span><strong>@FormatEach(result)</strong> each</span>
                        }
                    </span>
                }
                else if (!_busy)
                {
                    <span>@Wording.Local</span>
                }
                @if (_stale && !_busy)
                {
                    <span class="stale-note">Inputs changed. <button type="button" @onclick="() => SplitAsync(userStarted: true)">@Wording.Update</button></span>
                }
            </div>
        </section>

        <section class="panel demo-code" aria-labelledby="@($"{_id}-code")">
            <h2 class="demo-column-title" id="@($"{_id}-code")">C# code</h2>
            <CodeView Source="@_source" AriaLabel="@($"{Demo.SourceFile} source")" />
        </section>
    </div>

    <div class="visually-hidden" role="status" aria-live="polite">@_announcement</div>
</article>
