@page "/tools/extract-pages"
@inherits SingleFileToolBase
@* Extract pages (26112201 AC-04, D-007): landing, then every page to tick or a typed page list, then the new PDF. *@

<PageTitle>@Tool.DocumentTitle</PageTitle>
<PageDescription Text="@Tool.Subtitle" />
<CanonicalLink Path="@Tool.Route" />

<InputFile @ref="FileInput" class="visually-hidden" tabindex="-1" aria-hidden="true" accept=".pdf,application/pdf" OnChange="OnFilesAsync" />

@switch (Step)
{
    case ToolPageStep.Landing:
        <ToolLanding Tool="Tool" ChooseLabel="Choose a PDF file" SampleLabel="Use a sample PDF" HowToTask="extract pages from a PDF" Single="true"
                     LimitsLine="@ToolLimits.SinglePdfLimitsLine" Code="@ToolCode.ExtractPages()" Busy="Busy" Errors="FileErrors"
                     OnChoose="ChooseFilesAsync" OnSample="UseSample" />
        break;

    case ToolPageStep.Workspace when File is { } file && Selection is { } selection:
        <section class="tool-workspace" aria-labelledby="tool-heading">
            <div class="tool-workspace-head">
                <div>
                    <h1 id="tool-heading" tabindex="-1">@Tool.Heading</h1>
                    <p class="tool-workspace-meta">@FileLine</p>
                </div>
                <div class="tool-workspace-tools">
                    <div class="page-select-tools" role="group" aria-label="Pick pages">
                        <button type="button" class="btn btn-sm btn-outline" @onclick="selection.SelectAll">Select all</button>
                        <button type="button" class="btn btn-sm btn-outline" @onclick="selection.Clear">Clear</button>
                        <button type="button" class="btn btn-sm btn-outline" @onclick="selection.SelectOdd">Odd pages</button>
                        <button type="button" class="btn btn-sm btn-outline" @onclick="selection.SelectEven">Even pages</button>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline" disabled="@Busy" @onclick="ChooseFilesAsync"><Icon Name="upload" Size="16" /> Use another PDF</button>
                </div>
            </div>
            <ToolFileErrors Errors="FileErrors" Busy="Busy" />
            <PageGrid File="file.Value" Mode="PageGridMode.Keep" Selection="selection" OnToggle="selection.Toggle"
                      Label="@($"Pages of {file.Name}; pick the pages to keep")" />
        </section>
        <ToolActionBar ActionLabel="@($"Extract {CountText(selection.Count, "page")}")" Busy="Busy" CanRun="selection.IsUsable"
                       Error="@(RunError ?? selection.Error)" Hint="@(selection.Count == 0 ? "Pick at least one page to keep." : null)"
                       OnRun="ExtractAsync" OnStartOver="StartOverAsync">
            <div class="tool-option">
                <label for="extract-pages">Pages to keep, in order</label>
                <input id="extract-pages" class="form-control" value="@selection.Text" placeholder="1, 3-5" aria-describedby="extract-pages-hint"
                       @onchange="e => selection.SetText(e.Value?.ToString())" spellcheck="false" />
                <p class="tool-option-hint" id="extract-pages-hint">For example 1, 3-5. A typed list keeps your order.</p>
            </div>
            <div class="tool-option">
                <label for="extract-name">Save as</label>
                <input id="extract-name" class="form-control" @bind="_name" placeholder="@DefaultName" spellcheck="false" />
            </div>
        </ToolActionBar>
        break;

    case ToolPageStep.Done:
        <ToolDone Result="Result!" Code="@(DoneCode!)" Scenario="Tool.Scenario" OnDownload="DownloadAsync" OnOpen="OpenAsync">
            <Back>
                <button type="button" class="btn btn-outline" @onclick="() => GoTo(ToolPageStep.Workspace)">Pick other pages</button>
                <button type="button" class="btn btn-text" @onclick="StartOverAsync">Use another file</button>
            </Back>
        </ToolDone>
        break;
}

@code {
    private string? _name;

    private static PdfTool Tool => ToolCatalog.ExtractPages;

    private string DefaultName => $"{Stem}-extract";

    private Task ExtractAsync()
    {
        var file = File!;
        string pages = Selection!.Text;
        string output = SafeFileName.For(string.IsNullOrWhiteSpace(_name) ? DefaultName : _name, DefaultName);
        return RunAsync(() => ToolOperations.ExtractAsync(file.Value, pages, output), () => ToolCode.ExtractPages(file.Name, pages, output));
    }

    /// <inheritdoc />
    protected override void Reset()
    {
        base.Reset();
        _name = null;
    }
}
