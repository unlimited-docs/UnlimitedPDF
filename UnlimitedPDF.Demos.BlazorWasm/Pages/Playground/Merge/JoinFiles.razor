@page "/playground/merge/join-files"

<SamplePage @ref="_page" Demo="SampleCatalog.JoinFiles" Build="BuildAsync" PageCount="null" OnReset="Reset">
    <Inputs>
        <CollapsibleSection Title="Files, joined in this order">
            @for (int i = 0; i < _input.Files.Count; i++)
            {
                int index = i;
                var file = _input.Files[i];
                <div class="field">
                    <span class="field-label">@(index + 1). @file.Name (@file.File.PageCount @(file.File.PageCount == 1 ? "page" : "pages"))</span>
                    <div class="field-row">
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(index == 0)" aria-label="Move @file.Name up" @onclick="() => Move(index, -1)">Up</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(index == _input.Files.Count - 1)" aria-label="Move @file.Name down" @onclick="() => Move(index, 1)">Down</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Remove @file.Name" @onclick="() => Change(() => _input.Files.RemoveAt(index))">Remove</button>
                    </div>
                </div>
            }
            <PdfUploadField Id="join-upload" OnLoaded="file => Change(() => _input.Files.Add(file))" />
        </CollapsibleSection>
    </Inputs>
</SamplePage>

@code {
    private JoinFilesInput _input = Defaults();
    private SamplePage? _page;

    private Task<PdfDocument> BuildAsync() => Task.FromResult(JoinFilesSample.Build(_input));

    private void Change(Action change)
    {
        change();
        _page?.NotifyInputsChanged();
    }

    // Two built-in files from other demos, so the demo works before any upload.
    private static JoinFilesInput Defaults()
    {
        var input = new JoinFilesInput();
        input.Files.Add(new MergeFileInput("Text and pages", MergeDemoFiles.TextAndPages()));
        input.Files.Add(new MergeFileInput("Tables", MergeDemoFiles.Tables()));
        return input;
    }

    private void Move(int index, int step) => Change(() =>
    {
        var file = _input.Files[index];
        _input.Files.RemoveAt(index);
        _input.Files.Insert(index + step, file);
    });

    private void Reset() => _input = Defaults();
}
