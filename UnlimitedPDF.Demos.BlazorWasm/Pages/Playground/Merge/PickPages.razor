@page "/playground/merge/pick-pages"

<SamplePage @ref="_page" Demo="SampleCatalog.PickPages" Build="BuildAsync" PageCount="null" OnReset="Reset">
    <Inputs>
        <CollapsibleSection Title="File">
            @if (_input.File is { } file)
            {
                <p class="field-label">@file.Name (@file.File.PageCount @(file.File.PageCount == 1 ? "page" : "pages"))</p>
            }
            <PdfUploadField Id="pick-upload" Label="Use your own PDF" Multiple="false" OnLoaded="file => Change(() => _input.File = file)" />
        </CollapsibleSection>

        <CollapsibleSection Title="Pages">
            <div class="field">
                <label for="pick-pages">Pages, in order</label>
                <input id="pick-pages" class="form-control" value="@_input.Pages" placeholder="3, 1-2"
                       @onchange="e => Change(() => _input.Pages = e.Value?.ToString() ?? string.Empty)" />
                <p class="field-hint">Page numbers and ranges separated by commas, for example 3, 1-2.</p>
            </div>
        </CollapsibleSection>
    </Inputs>
</SamplePage>

@code {
    private PickPagesInput _input = Defaults();
    private SamplePage? _page;

    private Task<PdfDocument> BuildAsync() => Task.FromResult(PickPagesSample.Build(_input));

    private void Change(Action change)
    {
        change();
        _page?.NotifyInputsChanged();
    }

    // The Employee directory demo's several pages, so the demo works before any upload.
    private static PickPagesInput Defaults() => new() { File = new MergeFileInput("Employee directory", MergeDemoFiles.EmployeeDirectory()) };

    private void Reset() => _input = Defaults();
}
