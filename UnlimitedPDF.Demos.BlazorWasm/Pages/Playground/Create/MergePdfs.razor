@page "/playground/create/merge-pdfs"

<SamplePage @ref="_page" Demo="SampleCatalog.MergePdfs" Build="BuildAsync" PageCount="null" OnReset="Reset">
    <Inputs>
        <CollapsibleSection Title="Cover page">
            <label class="check-field">
                <input type="checkbox" checked="@_input.AddCover" @onchange="e => Change(() => _input.AddCover = (bool)e.Value!)" /> Add a cover page
            </label>
            <div class="field">
                <label for="cover-title">Title</label>
                <input id="cover-title" class="form-control" value="@_input.CoverTitle" disabled="@(!_input.AddCover)"
                       @onchange="e => Change(() => _input.CoverTitle = e.Value?.ToString() ?? string.Empty)" />
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Files">
            @foreach (var file in _input.Files)
            {
                <div class="field">
                    <span class="field-label">@file.Name (@file.File.PageCount pages)</span>
                    <div class="field-row">
                        <div class="field">
                            <label for="first-@file.GetHashCode()">From page</label>
                            <input id="first-@file.GetHashCode()" type="number" min="1" max="@file.File.PageCount" class="form-control"
                                   value="@file.FirstPage" @onchange="e => Change(() => file.FirstPage = Page(e.Value, file))" />
                        </div>
                        <div class="field">
                            <label for="last-@file.GetHashCode()">To page</label>
                            <input id="last-@file.GetHashCode()" type="number" min="1" max="@file.File.PageCount" class="form-control"
                                   value="@file.LastPage" @onchange="e => Change(() => file.LastPage = Page(e.Value, file))" />
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Change(() => _input.Files.Remove(file))">Remove</button>
                </div>
            }
            <div class="field">
                <label for="merge-upload">Add your own PDFs</label>
                <InputFile id="merge-upload" multiple accept=".pdf,application/pdf" OnChange="OnFilesChosenAsync" />
                @if (_error is not null)
                {
                    <p class="field-error" role="alert">@_error</p>
                }
                <p class="field-hint">Files are read in your browser and never uploaded. Encrypted PDFs can't be merged.</p>
            </div>
        </CollapsibleSection>
    </Inputs>
</SamplePage>

@code {
    private string? _error;
    private MergeInput _input = Defaults();
    private SamplePage? _page;

    private Task<PdfDocument> BuildAsync() => Task.FromResult(MergeSample.Build(_input));

    private void Change(Action change)
    {
        change();
        _page?.NotifyInputsChanged();
    }

    // Two built-in files, made by other demos and loaded back as existing PDFs, so the demo works before any upload.
    private static MergeInput Defaults()
    {
        var input = new MergeInput();
        input.Files.Add(new MergeFileInput("Text and pages", PdfFile.FromBytes(ToBytes(TextBasicsSample.Build(new TextBasicsInput())))));
        input.Files.Add(new MergeFileInput("Tables", PdfFile.FromBytes(ToBytes(TablesSample.Build(new TablesInput())))));
        return input;
    }

    private async Task OnFilesChosenAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        foreach (var browserFile in args.GetMultipleFiles(10))
        {
            var (file, error) = await UploadedPdfLoader.LoadAsync(browserFile);
            if (file is null)
            {
                _error = $"{browserFile.Name}: {error}";
                continue;
            }
            _input.Files.Add(new MergeFileInput(browserFile.Name, file));
        }
        _page?.NotifyInputsChanged();
    }

    // An empty or out-of-range page box means "from the start" or "to the end".
    private static int? Page(object? value, MergeFileInput file) =>
        int.TryParse(value?.ToString(), out int page) && page >= 1 && page <= file.File.PageCount ? page : null;

    private void Reset()
    {
        _error = null;
        _input = Defaults();
    }

    private static byte[] ToBytes(PdfDocument document)
    {
        using var stream = new MemoryStream();
        document.Save(stream);
        return stream.ToArray();
    }
}
