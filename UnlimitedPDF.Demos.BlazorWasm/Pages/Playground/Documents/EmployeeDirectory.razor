@page "/playground/documents/employee-directory"

<SamplePage Demo="SampleCatalog.EmployeeDirectory" Build="BuildAsync" PageCount="null" OnReset="Reset">
    <Inputs>
        <CollapsibleSection Title="Directory">
            <div class="field">
                <label for="company">Company name</label>
                <input id="company" class="form-control" @bind="_input.CompanyName" @bind:event="oninput" />
            </div>
            <div class="field">
                <label for="employee-count">Employees (1 to 1,000)</label>
                <input id="employee-count" type="number" min="1" max="1000" class="form-control" @bind="_input.EmployeeCount" />
            </div>
        </CollapsibleSection>

        <CollapsibleSection Title="Pages">
            <div class="field-row">
                <div class="field">
                    <label for="top-margin">Top margin (pt)</label>
                    <input id="top-margin" type="number" min="0" class="form-control" @bind="_input.TopMargin" />
                </div>
                <div class="field">
                    <label for="bottom-margin">Bottom margin (pt)</label>
                    <input id="bottom-margin" type="number" min="0" class="form-control" @bind="_input.BottomMargin" />
                </div>
            </div>
            <div class="field">
                <label for="repeat-header">
                    <input id="repeat-header" type="checkbox" @bind="_input.RepeatHeader" />
                    Repeat the header row on every page
                </label>
            </div>
        </CollapsibleSection>
    </Inputs>
</SamplePage>

@code {
    private EmployeeDirectoryInput _input = new();

    private Task<PdfDocument> BuildAsync() => Task.FromResult(EmployeeDirectorySample.Build(_input));

    private void Reset() => _input = new();
}
