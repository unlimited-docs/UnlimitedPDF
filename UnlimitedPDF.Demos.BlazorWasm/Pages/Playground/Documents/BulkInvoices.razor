@page "/playground/documents/bulk-invoices"
@inject SampleImageStore ImageStore

@* Many invoices in one run (AC-11): the list shows each invoice with a preview and a download, all of them download
   as one zip, and the status line gives the total time and the time per invoice. *@
<SplitPartsPage @ref="_page" Demo="SampleCatalog.BulkInvoices" Build="BuildAsync" OnReset="Reset" Wording="SplitPartsPage.InvoiceWording">
    <Inputs>
        <CollapsibleSection Title="Invoices">
            <div class="field">
                <label for="bulk-count">How many invoices (1 to 1,000)</label>
                <input id="bulk-count" type="number" min="1" max="@BulkInvoicesInput.MaxCount" class="form-control" @bind="_input.Count" />
                <p class="field-hint">Each invoice has its own number, buyer, and items. All of them are made here in your browser.</p>
            </div>
            <div class="field">
                <label for="bulk-seller">Seller</label>
                <input id="bulk-seller" class="form-control" @bind="_input.SellerName" @bind:event="oninput" />
            </div>
        </CollapsibleSection>
    </Inputs>
</SplitPartsPage>

@code {
    private BulkInvoicesInput _input = new();
    private SplitPartsPage? _page;

    private async Task<IReadOnlyList<SplitPartFile>> BuildAsync()
    {
        var images = await ImageStore.GetManyAsync("invoice-logo.png");
        var invoices = BulkInvoicesSample.Build(_input, images);
        return invoices.Select((invoice, index) => SplitPartFile.Generated(index + 1, invoice.FileName, invoice.Bytes)).ToList();
    }

    private void Reset() => _input = new();
}
