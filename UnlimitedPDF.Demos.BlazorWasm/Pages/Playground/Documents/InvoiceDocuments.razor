@page "/playground/documents/invoice"
@inject NavigationManager Navigation

@* One demo for the documents that share an invoice's shape (parties, line items, totals): the type is chosen here and
   kept in the address (?type=quotation), and each type keeps its own inputs, sample, and C# code. *@
<CascadingValue Name="DemoChoice" Value="_choice" IsFixed="false">
    @switch (Type)
    {
        case "quotation":
            <Quotation @key="Type" />
            break;
        case "purchase-order":
            <PurchaseOrder @key="Type" />
            break;
        case "delivery-note":
            <DeliveryNote @key="Type" />
            break;
        case "receipt":
            <Receipt @key="Type" />
            break;
        default:
            <Invoice @key="Type" />
            break;
    }
</CascadingValue>

@code {
    private static readonly IReadOnlyList<(string Value, string Label)> Types =
    [
        ("invoice", "Invoice"),
        ("quotation", "Quotation"),
        ("purchase-order", "Purchase order"),
        ("delivery-note", "Delivery note"),
        ("receipt", "Receipt"),
    ];

    private RenderFragment _choice = default!;

    /// <summary>
    /// Gets or sets the document type from the address; any other value shows the invoice.
    /// </summary>
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        string selected = Types.Any(t => t.Value == Type) ? Type! : "invoice";
        _choice = @<DemoChoice Legend="Document type" Options="Types" Selected="@selected" OnSelect="Select" />;
    }

    private void Select(string value) =>
        Navigation.NavigateTo(value == "invoice" ? "playground/documents/invoice" : $"playground/documents/invoice?type={value}", replace: true);
}
