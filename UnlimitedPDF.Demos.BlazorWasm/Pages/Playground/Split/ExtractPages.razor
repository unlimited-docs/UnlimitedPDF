@page "/playground/split/extract-pages"

<SamplePage @ref="_page" Demo="SampleCatalog.ExtractPages" BuildFile="BuildAsync" PageCount="null" OnReset="Reset">
    <Inputs>
        <CollapsibleSection Title="File">
            @if (_input.File is { } file)
            {
                <p class="field-label">@file.Name (@file.File.PageCount @(file.File.PageCount == 1 ? "page" : "pages"))</p>
            }
            <PdfUploadField Id="extract-upload" Label="Use your own PDF" Multiple="false" Hint="@UploadHint"
                            OnLoaded="file => Change(() => _input.File = file)" />
        </CollapsibleSection>

        <CollapsibleSection Title="Pages">
            <div class="field">
                <label for="extract-pages">Pages to extract, in order</label>
                <input id="extract-pages" class="form-control" value="@_input.Pages" placeholder="4, 1-2"
                       aria-describedby="extract-pages-hint"
                       @onchange="e => Change(() => _input.Pages = e.Value?.ToString() ?? string.Empty)" />
                <p class="field-hint" id="extract-pages-hint">Page numbers and ranges separated by commas, for example 4, 1-2. A page can appear more than once, and 9-7 gives pages 9, 8, 7.</p>
            </div>
        </CollapsibleSection>
    </Inputs>
</SamplePage>

@code {
    private const string UploadHint = "Files are read in your browser and never uploaded. Encrypted PDFs can't be used.";
    private PageSelectionInput _input = Defaults();
    private SamplePage? _page;

    private Task<byte[]> BuildAsync() => Task.FromResult(ExtractPagesSample.Build(_input));

    private void Change(Action change)
    {
        change();
        _page?.NotifyInputsChanged();
    }

    // The Headers and footers demo's several-page report, so the demo works before any upload.
    private static PageSelectionInput Defaults() => new() { File = new MergeFileInput("Report", MergeDemoFiles.Report()), Pages = "4, 1-2" };

    private void Reset() => _input = Defaults();
}
