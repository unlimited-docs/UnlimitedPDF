@page "/playground/split/remove-pages"

<SamplePage @ref="_page" Demo="SampleCatalog.RemovePages" BuildFile="BuildAsync" PageCount="null" OnReset="Reset">
    <Inputs>
        <CollapsibleSection Title="File">
            @if (_input.File is { } file)
            {
                <p class="field-label">@file.Name (@file.File.PageCount @(file.File.PageCount == 1 ? "page" : "pages"))</p>
            }
            <PdfUploadField Id="remove-upload" Label="Use your own PDF" Multiple="false" Hint="@UploadHint"
                            OnLoaded="file => Change(() => _input.File = file)" />
        </CollapsibleSection>

        <CollapsibleSection Title="Pages">
            <div class="field">
                <label for="remove-pages">Pages to remove</label>
                <input id="remove-pages" class="form-control" value="@_input.Pages" placeholder="1-4"
                       aria-describedby="remove-pages-hint"
                       @onchange="e => Change(() => _input.Pages = e.Value?.ToString() ?? string.Empty)" />
                <p class="field-hint" id="remove-pages-hint">Page numbers and ranges separated by commas, for example 1, 3-4. The pages left keep their order.</p>
            </div>
        </CollapsibleSection>
    </Inputs>
</SamplePage>

@code {
    private const string UploadHint = "Files are read in your browser and never uploaded. Encrypted PDFs can't be used.";
    private PageSelectionInput _input = Defaults();
    private SamplePage? _page;

    private Task<byte[]> BuildAsync() => Task.FromResult(RemovePagesSample.Build(_input));

    private void Change(Action change)
    {
        change();
        _page?.NotifyInputsChanged();
    }

    // The Headers and footers demo's several-page report, so the demo works before any upload.
    private static PageSelectionInput Defaults() => new() { File = new MergeFileInput("Report", MergeDemoFiles.Report()), Pages = "1-4" };

    private void Reset() => _input = Defaults();
}
