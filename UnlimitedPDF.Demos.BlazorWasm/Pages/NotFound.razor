@page "/not-found"
@layout MainLayout

<PageTitle>Page not found · UnlimitedPDF</PageTitle>
<PageDescription Text="This page doesn't exist. The UnlimitedPDF playground has every demo." />
@* A missing page is served with the app's normal response, so this keeps it out of search results. *@
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<section class="not-found">
    <h1>Page not found</h1>
    <p>This page doesn't exist. The playground has every demo.</p>
    <a class="btn btn-solid theme-primary" href="playground">Open the playground</a>
</section>
