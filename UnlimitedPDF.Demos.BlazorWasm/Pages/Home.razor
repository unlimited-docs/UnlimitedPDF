@page "/"

<PageTitle>UnlimitedPDF: C# PDF library for .NET, with live demos</PageTitle>
<PageDescription Text="Try UnlimitedPDF, the C# PDF library for .NET, in your browser: create PDFs with text, tables, and images, merge and split PDFs, and convert HTML to PDF." />
<CanonicalLink Path="" />

@* The home page (D-026; layout "Two paths", QF-26112201; hero "Code first", QF-26112503): the hero with the install
   command and a first PDF that compiles as pasted; two paths, one for developers (where to go next) and one for
   visitors' own files (the free tools); the real-life documents as cards; the other capabilities as rows with their
   demos, code, and tools; the benefits; "How do I...?"; and the FAQ band. *@
<section class="hero">
    <div class="hero-inner">
        <div class="hero-text">
            @* The current release and what it adds (QF-26111209); the version is read from the built library. Update
               the sentence with each release. *@
            @if (LibraryRelease.Version.Length > 0)
            {
                <a class="hero-release" href="@LibraryRelease.NotesUrl" target="_blank" rel="noopener">
                    <span class="hero-release-version">v@(LibraryRelease.Version)</span>
                    <span class="hero-release-text">Your own fonts and more languages</span>
                    <Icon Name="arrow" Size="14" /><span class="visually-hidden"> release notes (opens in a new tab)</span>
                </a>
            }
            <h1>The pure .NET <span>PDF library</span></h1>
            <p class="hero-lead">
                Create, merge, split, and convert HTML to PDF from C#.
                No engine required: it runs wherever .NET 6 or later runs.
            </p>
            <div class="hero-actions">
                <a class="btn btn-lg btn-cta" href="getting-started">Get started <Icon Name="arrow" Size="18" /></a>
                <a class="btn btn-lg btn-outline" href="@ScenarioGallery.Route">Browse @ScenarioGallery.Scenarios.Count scenarios</a>
            </div>
            @* What developers check first, each true of the shipped package (PR-012: the csproj's target frameworks
               and license, PR-005). *@
            <ul class="hero-facts">
                <li><Icon Name="check" Size="16" /> .NET 6, 8, 9, 10, and 11</li>
                <li><Icon Name="check" Size="16" /> Apache-2.0 license</li>
                <li><Icon Name="check" Size="16" /> No PDF engine or native code</li>
            </ul>
        </div>
        @* The first PDF, ready to paste into a console app's Program.cs: the install command, then the code. *@
        <div class="hero-code" role="region" aria-labelledby="first-title">
            <h2 id="first-title" class="visually-hidden">Your first PDF</h2>
            <InstallCommand />
            <div class="first-pdf-code">
                <CodeView Source="@_firstPdf" AriaLabel="Code sample: your first PDF" />
            </div>
            <p class="hero-code-note">Run it, and hello.pdf holds one page with a line of text.</p>
        </div>
    </div>
</section>

@* Two paths (QF-26112201): developers go on to the C# for what they're building (QF-26112503: the hero holds the
   install command and the first PDF); visitors with their own files start with the free tools (26112201 AC-07,
   D-004), one tile per tool and all tools. *@
<section class="section home-section home-paths">
    <div class="home-path" aria-labelledby="next-title" role="region">
        <h2 id="next-title" class="home-path-title">For developers</h2>
        <p class="home-path-lead">Next, the C# for what you're building. Each opens a demo you can edit.</p>
        <ul class="home-tools-list">
            @foreach (var (name, text, iconName, href) in NextSteps)
            {
                <li>
                    <a class="home-tool" href="@href">
                        <span class="tool-card-icon" aria-hidden="true"><Icon Name="@iconName" Size="18" /></span>
                        <span>@name<small>@text</small></span>
                    </a>
                </li>
            }
        </ul>
        <a class="home-path-more" href="#capabilities">See the C# for each capability <Icon Name="arrow" Size="16" /></a>
    </div>
    <div class="home-path home-tools" aria-labelledby="home-tools-title" role="region">
        <h2 id="home-tools-title" class="home-path-title">For your files</h2>
        <p class="home-path-lead"><Icon Name="check" Size="16" /> @ToolCatalog.HubHeading that run in your browser. Nothing is uploaded.</p>
        <ul class="home-tools-list">
            @foreach (var tool in ToolCatalog.All)
            {
                <li>
                    <a class="home-tool" href="@tool.Route">
                        <span class="tool-card-icon" aria-hidden="true"><Icon Name="@tool.Icon" Size="18" /></span>
                        <span>@tool.Name<small>@tool.Description</small></span>
                    </a>
                </li>
            }
        </ul>
        <a class="home-path-more" href="@ToolCatalog.HubRoute">All tools <Icon Name="arrow" Size="16" /></a>
    </div>
</section>

@* The real-life documents as picture cards, each demo once on the page (QF-26112201 F-1): they replace the popular
   scenarios and the documents capability row, which showed the same demos twice. The section keeps the row's anchor. *@
<section id="@Documents.Id" class="section home-section" aria-labelledby="documents-title">
    <div class="section-head">
        <div>
            <h2 id="documents-title" class="section-title">@Documents.Title</h2>
            <p class="section-lead">Complete documents you can edit and download, each ready to run, change, and copy.</p>
        </div>
        <a class="section-more" href="@ScenarioGallery.Route">See all @ScenarioGallery.Scenarios.Count scenarios <Icon Name="arrow" Size="16" /></a>
    </div>
    <ul class="gallery-grid">
        @foreach (var demo in Documents.Demos)
        {
            <ScenarioCard Demo="demo" HeadingLevel="3" />
        }
    </ul>
</section>

<section id="capabilities" class="section home-section" aria-labelledby="capabilities-title">
    <h2 id="capabilities-title" class="section-title">Capabilities</h2>
    <p class="section-lead">Each one is a few lines of C#. Open a demo to change the data and see the PDF.</p>
    @* A link to each row, so a visitor can go straight to one (QF-26112201 F-7). *@
    <nav class="cap-jump" aria-label="Capabilities">
        <span class="cap-jump-label">Jump to:</span>
        <ul>
            @foreach (var category in Capabilities)
            {
                <li><a href="#@category.Id">@category.Title</a></li>
            }
        </ul>
    </nav>
    <div class="cap-rows">
        @foreach (var category in Capabilities)
        {
            <CapabilityRow Category="category" />
        }
    </div>
</section>

<section class="section home-section" aria-labelledby="why-title">
    <h2 id="why-title" class="section-title">Why UnlimitedPDF</h2>
    <ul class="benefits">
        @foreach (var (title, text) in Benefits)
        {
            <li class="panel benefit"><h3>@title</h3><p>@text</p></li>
        }
    </ul>
</section>

<section id="how-do-i" class="section home-section" aria-labelledby="how-do-i-title">
    <h2 id="how-do-i-title" class="section-title">How do I...?</h2>
    <p class="section-lead">Common tasks, each answered by a demo you can run and edit.</p>
    <ul class="questions">
        @foreach (var question in HomeQuestions.Questions)
        {
            <li>
                <a class="panel question" href="@question.Href">
                    <span class="question-text">@question.Text</span>
                    <span class="question-demo"><Icon Name="@question.Demo.Icon" Size="16" /> @question.Demo.Title</span>
                </a>
            </li>
        }
    </ul>
</section>

<section class="section home-section" aria-labelledby="faq-band-title">
    <div class="faq-band">
        <div>
            <h2 id="faq-band-title">Questions before you start?</h2>
            <p>Install, .NET versions, Blazor WebAssembly, fonts and languages, tables, merge and split, HTML to PDF, and the license.</p>
        </div>
        <a class="btn btn-lg btn-cta" href="faq">Read the FAQ</a>
    </div>
</section>

@code {
    // The six benefits (D-026): each true of the shipped library (PR-012), and none repeating the hero or a capability
    // row (QF-26112201 F-3).
    private static readonly (string Title, string Text)[] Benefits =
    [
        ("Safe with files you didn't make", "Reads PDF 1.0 to 2.0 behind size, stream, and object limits you can change."),
        ("Clear errors", "Bad input fails at load with a reason you can check: encrypted, damaged, no pages, or too large."),
        ("Small, searchable PDFs", "Embeds only the glyphs it uses from your fonts, and copied text reads back as written."),
        ("Code that compiles", "The C# on this site comes from source that builds and is tested with the library."),
        ("Files stay on the device", "In Blazor WebAssembly it runs in the browser, so files don't have to reach a server."),
        ("Free and open", "Apache-2.0 licensed, on NuGet and GitHub."),
    ];

    private string _firstPdf = string.Empty;

    // Where a developer goes after the first PDF (QF-26112503): the guide, then the demos for the common tasks, each
    // described by what the demo shows (PR-012).
    private static (string Name, string Text, string Icon, string Href)[] NextSteps =>
    [
        ("Get started", "Install, the first PDF, and where to go next.", "spark", "getting-started"),
        ("Tables", "Columns, borders, and a header row on every page.", "table", SampleCatalog.Tables.Route),
        ("Images", "JPG and PNG pictures on a page or in a table cell.", "image", SampleCatalog.Images.Route),
        ("Merge and split", "Join PDFs, pick pages, and add bookmarks.", "merge", SampleCatalog.JoinFiles.Route),
        ("HTML to PDF", "Turn HTML and CSS into a PDF.", "html", SampleCatalog.HtmlToPdf.Route),
        ("Fonts and languages", $"Your own fonts and text in {LanguageInvoices.All.Count(l => l.Id != "mixed")} languages.", "language", SampleCatalog.FontsAndLanguages.Route),
    ];

    // The real-life documents, shown as picture cards in their own section (QF-26112201 F-1).
    private static SampleCategory Documents => SampleCatalog.Categories.Single(c => c.Id == "documents");

    // The capability rows, in catalogue order: every other category. With the documents section, every demo is one
    // click from the home page.
    private static IEnumerable<SampleCategory> Capabilities => SampleCatalog.Categories.Where(c => c != Documents);

    // The first PDF as a console app's whole Program.cs: the using line, then the snippet (QF-26112503).
    /// <inheritdoc />
    protected override void OnInitialized() => _firstPdf = "using UnlimitedPDF;\n\n" + SnippetText.Extract(SampleSource.Read("HomeSnippets.cs"), "first");
}
