@page "/"

<PageTitle>UnlimitedPDF Demos: PDF generation in pure .NET</PageTitle>

<section class="hero">
    <div class="hero-eyebrow"><Icon Name="spark" Size="14" /> Runs entirely in your browser</div>
    <h1>Generate PDFs in <span>pure .NET</span></h1>
    <p class="hero-lead">
        UnlimitedPDF builds PDF documents with text, tables, and JPEG or PNG images from plain C#.
        No native libraries, no server. Every demo below runs right here, and shows the code behind it.
    </p>
    <div class="hero-actions">
        <a class="btn btn-lg btn-solid theme-primary" href="playground">Try the playground <Icon Name="arrow" Size="18" /></a>
        <a class="btn btn-lg btn-outline" href="https://github.com/unlimited-docs/UnlimitedPDF" target="_blank" rel="noopener">View on GitHub</a>
    </div>
    <InstallCommand />
</section>

<nav class="jump-links" aria-label="Sections on this page">
    @foreach (var category in Capabilities)
    {
        <a class="jump-link tone-@category.Tone" href="#@category.Id"><Icon Name="@(category.Icon!)" Size="16" /> @category.Title</a>
    }
    <a class="jump-link" href="#documents"><Icon Name="invoice" Size="16" /> Documents</a>
    <a class="jump-link" href="#how-do-i"><Icon Name="arrow" Size="16" /> How do I...?</a>
</nav>

<section class="showcase" aria-label="Real-life documents you can build">
    @* A stylized illustration of the four document demos; the phone-sized copy is chosen by srcset. It is in the
       first screen at every width and is the page's largest picture, so it loads at once, ahead of other images. *@
    <img src="images/unlimitedpdf-demos-hero-1200.jpg"
         srcset="images/unlimitedpdf-demos-hero-800.jpg 800w, images/unlimitedpdf-demos-hero-1200.jpg 1200w"
         sizes="(max-width: 1240px) calc(100vw - 2.5rem), 1200px"
         width="1200" height="675" fetchpriority="high" decoding="async"
         alt="Illustration of UnlimitedPDF Demos: an invoice, a medical report, a receipt, and a certificate, each with its own logo" />
</section>

<div class="cap-rows">
    @foreach (var category in Capabilities)
    {
        <CapabilityRow Category="category" />
    }
</div>

<section id="documents" class="section home-section" aria-labelledby="documents-title">
    <div class="section-head">
        <h2 id="documents-title">@Documents.Title</h2>
        <p>@Documents.Description</p>
    </div>
    <DocumentTiles />
</section>

<section id="how-do-i" class="section home-section" aria-labelledby="how-do-i-title">
    <div class="section-head">
        <h2 id="how-do-i-title">How do I...?</h2>
        <p>Common tasks, each answered by a demo you can run and edit.</p>
    </div>
    <ul class="questions">
        @foreach (var question in HomeQuestions.Questions)
        {
            <li>
                <a class="panel question" href="@question.Href">
                    <span class="question-text">@question.Text</span>
                    <span class="question-demo"><Icon Name="@question.Demo.Icon" Size="16" /> @question.Demo.Title</span>
                </a>
            </li>
        }
    </ul>
    <a class="questions-more" href="faq">More questions in the FAQ <Icon Name="arrow" Size="16" /></a>
</section>

<section class="section">
    <div class="facts">
        <div class="panel fact"><strong>Pure managed .NET</strong><span>No native or third-party engine to install.</span></div>
        <div class="panel fact"><strong>.NET 6, 8, 9, and 10</strong><span>One package for every supported target.</span></div>
        <div class="panel fact"><strong>Runs anywhere .NET runs</strong><span>Servers, desktops, and WebAssembly in the browser.</span></div>
        <div class="panel fact"><strong>Open source</strong><span>Apache-2.0 licensed, developed on GitHub.</span></div>
    </div>
</section>

<footer class="footer">
    UnlimitedPDF is open source under the Apache-2.0 license. Demo data is fictional.
</footer>

@code {
    // The four capability rows, in catalogue order: the categories with a code sample.
    private static IEnumerable<SampleCategory> Capabilities => SampleCatalog.Categories.Where(category => category.Snippet is not null);

    private static SampleCategory Documents => SampleCatalog.Categories.Single(category => category.Id == "documents");
}
