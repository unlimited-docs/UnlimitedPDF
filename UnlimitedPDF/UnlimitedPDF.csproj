<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>UnlimitedPDF</PackageId>
    <Version>1.0.1</Version>
    <PackageVersion>1.0.1</PackageVersion>
    
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/unlimited-docs/UnlimitedPDF</RepositoryUrl>
    <PackageProjectUrl>https://unlimitedpdf.dev/</PackageProjectUrl>
    <PackageTags>pdf;pdf-library;pdf-generation;create-pdf;pdf-tables;pdf-images;pdf-headers-footers;merge-pdf;split-pdf;html-to-pdf;enterprise-pdf;dotnet;csharp;blazor;unlimitedpdf;unlimited-pdf</PackageTags>
    <Description>UnlimitedPDF is an enterprise-grade, pure .NET PDF library for creating PDF documents with text, tables, images, headers, and footers, merging and splitting existing PDFs, and converting HTML to PDF, saved to a file or a stream. No third-party dependencies.</Description>
    <PackageReleaseNotes>1.0.1: text now shows in iPhone and iPad PDF viewers. Every page names the font its text uses; pages look the same everywhere else, and the API is unchanged. https://github.com/unlimited-docs/UnlimitedPDF#changes-in-101 — 1.0.0: merge PDFs, split PDFs, and HTML to PDF with a built-in renderer; tables that continue across pages with repeated header rows; headers, footers, page numbers, and a body flow that adds pages as needed; JPEG and PNG images, also in table cells; colors from RGB or hex; .NET 11 support. Part of the API is renamed, so code written for 0.0.x needs the new names. The full change list and the upgrade table: https://github.com/unlimited-docs/UnlimitedPDF#changes-in-100</PackageReleaseNotes>
    <Authors>Vikram Reddy</Authors>
    <Company>Unlimited Docs</Company>
    <Copyright>Copyright © 2025-2026 UnlimitedPDF</Copyright>

    <TargetFrameworks>net6.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\nuget\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\nuget\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnlimitedPDF.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="6.0.36" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
  </ItemGroup>

</Project>
